        {
          "name": "state",
          "type": "dropdown",
          "title": { "en": "State", "nl": "Status" },
          "placeholder": { "en": "Choose state", "nl": "Kies status" },
          "values": [
            { "id": "run", "title": { "en": "Run", "nl": "Starten" } },
            { "id": "pause", "title": { "en": "Pause", "nl": "Pauzeren" } },
            { "id": "stop", "title": { "en": "Stop", "nl": "Stoppen" } }
          ]
        }
      ]
    },
